# GEMINI_API_KEY: Optional (only if using AI features; unused by core game).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---- VERCEL HOBBY (FRONTEND BUILD) ----
# WebSocket URL of your Render Free Web Service (must use wss:// in production)
# Example: wss://zombie-shooter-server-i03r.onrender.com/ws
VITE_MULTIPLAYER_WS_URL="wss://zombie-shooter-server-i03r.onrender.com/ws"

# Supabase Free project credentials (safe public anon key for client auth & RLS-protected saves)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ---- RENDER FREE WEB SERVICE (PERSISTENT WEBSOCKET BACKEND) ----
# Allowed frontend origin (e.g. https://your-game.vercel.app or * during testing)
CORS_ORIGIN="*"

# Supabase credentials for server JWT verification & match result persistence
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
